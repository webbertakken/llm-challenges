@startuml llm-challenges-overview
!theme blueprint

title llm-challenges — Repository Overview

package "Root" as root {
  file "README.md" as readme <<docs>>
  file "INSTRUCTIONS.md" as instructions <<docs>>
  file "package.json" as pkg <<config>>
  file ".gitignore" as gitignore <<config>>

  note right of instructions
    Rules for LLM agents:
    • Identify harness + model
    • Read challenge README
    • Write solution to results folder
    • Verify with tsgo/tsx
    • Record timing
  end note
}

package "Challenge 01\nDeep Readonly & Recursive Utility Types" as ch01 <<TypeScript / Type-level>> {
  file "README.md" as ch01_readme <<spec>>
  package "pi_opus-4.6_2026-04-03" as ch01_result {
    file "types.ts" as ch01_types
    file "tests.ts" as ch01_tests
    file "examples.ts" as ch01_examples
    file "duration-58-seconds.txt" as ch01_dur
  }
}

package "Challenge 02\nSolar System in p5.js" as ch02 <<JavaScript / Creative Coding>> {
  file "README.md" as ch02_readme <<spec>>
  package "pi_opus-4.6_2026-04-03" as ch02_result {
    file "index.html" as ch02_html
    file "sketch.js" as ch02_sketch
    file "duration-48-seconds.txt" as ch02_dur
  }
}

package "Challenge 03\nRepo Overview with PlantUML" as ch03 <<Documentation / Diagrams>> {
  file "README.md" as ch03_readme <<spec>>
}

' Dependencies
package "Dev Dependencies\n(node_modules)" as deps {
  component "typescript ^5.7" as ts
  component "@typescript/native-preview ^7.0" as tsgo
}

' Relationships
instructions --> ch01_readme : "agent reads\nchallenge spec"
instructions --> ch02_readme : "agent reads\nchallenge spec"
instructions --> ch03_readme : "agent reads\nchallenge spec"

ch01_readme ..> ch01_result : "LLM produces\nsolution"
ch02_readme ..> ch02_result : "LLM produces\nsolution"

pkg --> deps : "npm install"
ch01_result ..> tsgo : "verified with\ntsgo --noEmit"

@enduml
